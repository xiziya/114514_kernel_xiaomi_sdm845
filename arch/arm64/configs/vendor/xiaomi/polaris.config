# Platform
CONFIG_MACH_XIAOMI_D5X=y

# Touchscreen
CONFIG_SECURE_TOUCH=y
CONFIG_TOUCHSCREEN_FT5X46=y
CONFIG_TOUCHSCREEN_FT5X46_I2C=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE_FORCE=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV_FORCE is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_SPI_FORCE is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE_FORCE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING_FORCE=y

# Wireless Supply
CONFIG_IDT_P9220=y

# HyperOS userspace compatibility
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_FINGERPRINT_SYNAPTICS4302=y

# Speaker identification used by the TAS2557 audio path
CONFIG_MFD_SPK_ID=y

# Persistent crash diagnostics
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
# Keep a persistent per-CPU ftrace ring for display/GPU hangs.
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_DEBUG_FS=y
CONFIG_FUNCTION_TRACER=y
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"
CONFIG_CMDLINE_EXTEND=y

# Android userspace filesystems
CONFIG_EXFAT_FS=y
CONFIG_CIFS=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_950=y
CONFIG_NLS_UTF8=y
